#!/usr/bin/env bash
# aov-lab-review-read — read review log and config for dashboard
# Usage: aov-lab-review-read
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval $("$SCRIPT_DIR/aov-lab-slug" 2>/dev/null)
GSTACK_HOME="${GSTACK_HOME:-$HOME/.aov-lab}"
cat "$GSTACK_HOME/projects/$SLUG/$BRANCH-reviews.jsonl" 2>/dev/null || echo "NO_REVIEWS"
echo "---CONFIG---"
"$SCRIPT_DIR/aov-lab-config" get skip_eng_review 2>/dev/null || echo "false"
echo "---HEAD---"
git rev-parse --short HEAD 2>/dev/null || echo "unknown"
