#!/usr/bin/env bash
# aov-lab-review-log — atomically log a review result
# Usage: aov-lab-review-log '{"skill":"...","timestamp":"...","status":"..."}'
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval $("$SCRIPT_DIR/aov-lab-slug" 2>/dev/null)
GSTACK_HOME="${GSTACK_HOME:-$HOME/.aov-lab}"
mkdir -p "$GSTACK_HOME/projects/$SLUG"
echo "$1" >> "$GSTACK_HOME/projects/$SLUG/$BRANCH-reviews.jsonl"
